# Copy to ignored .env.local. Never put keys in browser code or commit .env.local.
OPENAI_API_KEY=
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCOUNTER_ACCESS_TOKEN=
# Enable only when a valid server-side provider key and operator token are set.
ENCOUNTERS_ENABLED=false
PORT=8080
